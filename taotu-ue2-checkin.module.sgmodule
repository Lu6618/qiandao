#!name=桃兔 UE2 自动签到
#!desc=自动抓取 ue2.taotu.ink 登录态并执行每日积分签到。
#!category=Scripts

[Script]
# 直接使用 GitHub raw 脚本地址。
桃兔登录态捕获 = type=http-request,pattern=^https:\/\/ue2\.taotu\.ink\/(?:api\/requests\/check|api\/user\/points\/info|\?tab=profile|$),requires-body=false,script-path=https://raw.githubusercontent.com/Lu6618/qiandao/main/taotu-checkin.js,timeout=10
桃兔每日签到 = type=cron,cronexp="0 9 * * *",script-path=https://raw.githubusercontent.com/Lu6618/qiandao/main/taotu-checkin.js,timeout=30

[MITM]
hostname = %APPEND% ue2.taotu.ink
